// HoikuNote — Prisma Schema v2

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String?
  avatarUrl  String?
  targetAge     Int?     // 担当クラスの年齢（0〜5）
  bio           String?
  classSize     Int?     // クラスの子どもの人数
  teachingStyle String?  // 保育スタイル・大切にしていること
  childrenNote  String?  @db.Text // 子どもたちの傾向・気になっていること
  createdAt     DateTime @default(now())

  memos            DailyMemo[]
  plans            WeeklyPlan[]
  lineUser         LineUser?
  templates        PlanTemplate[]
  posts            CommunityPost[]
  likes            PostLike[]
  savedPosts       SavedPost[]
  following        Follow[]        @relation("Following")
  followers        Follow[]        @relation("Followers")
  annualEvents     AnnualEvent[]
  userFormatConfig UserFormatConfig?

  // NextAuth
  accounts Account[]
  sessions Session[]
}

model DailyMemo {
  id        String   @id @default(cuid())
  userId    String
  content   String
  source    String   // "line" | "web"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model WeeklyPlan {
  id            String   @id @default(cuid())
  userId        String
  weekStartDate DateTime
  targetAge     Int
  rawMemo       String   @db.Text
  goal          String   @db.Text
  content       String   @db.Text
  environment   String   @db.Text
  support       String   @db.Text
  guidelineRef  String
  templateId    String?
  isPublic      Boolean  @default(false)
  weekTheme     String?
  reflection    String?  @db.Text
  fields        Json?
  isDraft       Boolean  @default(false)
  updatedAt     DateTime @updatedAt @default(now())
  createdAt     DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  template      PlanTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  relatedEvents AnnualEvent[]

  @@index([userId, weekStartDate])
}

model AnnualEvent {
  id          String    @id @default(cuid())
  userId      String
  title       String
  date        DateTime
  eventType   EventType
  targetAge   Int?
  note        String?   @db.Text
  createdAt   DateTime  @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyPlans WeeklyPlan[]

  @@index([userId, date])
}

enum EventType {
  CEREMONY
  SEASONAL
  OUTING
  DAILY
  OTHER
}

model PlanTemplate {
  id             String   @id @default(cuid())
  userId         String
  name           String
  originalPdfUrl String
  layoutJson     String   @db.Text
  createdAt      DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plans WeeklyPlan[]

  @@index([userId])
}

model LineUser {
  id         String   @id @default(cuid())
  userId     String   @unique
  lineUserId String   @unique
  linkedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 連携コード（有効期限10分）
model LineLinkCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  code      String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ===== コミュニティ =====

model CommunityPost {
  id         String   @id @default(cuid())
  userId     String
  type       String   // "weekly_plan" | "activity_idea" | "discussion"
  targetAge  Int?
  season     String?
  title      String?
  content    String   @db.Text
  tags       String[]
  likesCount Int      @default(0)
  createdAt  DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes    PostLike[]
  savedBy  SavedPost[]
  comments PostComment[]

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([targetAge, createdAt])
}

model PostLike {
  id        String        @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime      @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model SavedPost {
  id        String        @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime      @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model PostComment {
  id        String        @id @default(cuid())
  userId    String
  postId    String
  content   String        @db.Text
  createdAt DateTime      @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model UserFormatConfig {
  id           String   @id @default(cuid())
  userId       String   @unique
  facilityType String
  layoutType   String
  activeFields String[]
  fieldLayout  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// NextAuth.js 必須モデル
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
